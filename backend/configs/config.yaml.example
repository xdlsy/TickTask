server:
  host: "0.0.0.0"
  port: 8080
  mode: "release"

database:
  path: "./data/ticktask.db"

cors:
  allowed_origins:
    - "http://localhost:5173"

ai:
  provider: "openai"
  base_url: "https://api.openai.com/v1"
  model: "gpt-4o-mini"
  timeout: 30s
  # API Key is entered via the Settings page (stored encrypted in DB).
  # Do NOT put it in this file.
